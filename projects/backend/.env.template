# Backend local config (copy to .env, gitignored).
PORT=3001
DATABASE_URL=postgresql://kasakame:kasakame@localhost:5432/kasakame
# JWT secret (generate with: openssl rand -hex 32).
SESSION_SECRET=change-me
# SIWE-style domain binding for sign-in challenges (must match the served frontend).
# Must be the frontend host exactly as the browser sees it, port included -
# wallets hash it into the ARC-60 authenticator data, so any mismatch breaks verification.
APP_DOMAIN=localhost:5173
APP_URI=http://localhost:5173
# Pinata JWT for server-side IPFS pinning (POST /uploads).
# Create one at https://app.pinata.cloud/developers/api-keys.
PINATA_JWT=change-me
