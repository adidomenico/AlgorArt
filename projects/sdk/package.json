{
  "name": "@kasakame/sdk",
  "version": "0.1.0",
  "author": {
    "name": "Alessio Di Domenico",
    "email": "alessio.661@hotmail.it"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Chain layer for kasakame: claim-tree proofs, campaign reads, and transaction assembly",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.0.0",
    "@noble/hashes": "^2.4.0",
    "algosdk": "^3.9.0"
  },
  "scripts": {
    "prebuild": "node scripts/codegen.mjs",
    "build": "tsc -p tsconfig.build.json",
    "codegen": "node scripts/codegen.mjs",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.11",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.5"
  }
}
