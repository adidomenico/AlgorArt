{
  "name": "@kasakame/sdk",
  "version": "0.1.0",
  "author": {
    "name": "Alessio Di Domenico",
    "email": "alessio.661@hotmail.it"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "description": "Chain layer for kasakame: claim-tree proofs, campaign reads, and transaction assembly",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=9.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^64.3.3",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-jsdoc": "^1.8.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
